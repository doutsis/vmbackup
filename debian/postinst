#!/bin/bash
# postinst - runs after package installation
set -e

case "$1" in
    configure)
        # Create symlink in PATH
        ln -sf /opt/vmbackup/vmbackup.sh /usr/local/bin/vmbackup
        ln -sf /opt/vmbackup/vmrestore.sh /usr/local/bin/vmrestore

        # =====================================================================
        # SECURITY HARDENING
        # =====================================================================
        # Ownership model: root:backup
        #   - root: full access (runs backups via systemd)
        #   - backup group: read access (browse backups, view logs)
        #   - world: no access
        #
        # Users who need to browse backups:
        #   sudo usermod -aG backup <username>
        # Users who need virsh access (VM status, etc.):
        #   sudo usermod -aG libvirt <username>
        # =====================================================================

        # Ensure backup group exists (standard Debian group, GID 34)
        if ! getent group backup >/dev/null 2>&1; then
            addgroup --system backup
        fi

        # Set ownership: root:backup on the entire install tree
        chown -R root:backup /opt/vmbackup
        chmod 750 /opt/vmbackup

        # SEC-02: strip group/other-write recursively so a backup-group member
        # cannot replace code the root nightly sources (lib/, modules/, config/,
        # transports/, cloud_transports/). Idempotent -- self-heals umask-002 dir
        # drift AND any world-readable config files on every install/upgrade.
        # Capital X preserves the binaries' exec bit; files settle to 0640, dirs 0750.
        chmod -R u=rwX,g=rX,o= /opt/vmbackup

        # Create log directory
        mkdir -p /var/log/vmbackup
        chown root:backup /var/log/vmbackup
        chmod 750 /var/log/vmbackup

        # vmrestore log directory (parallel to vmbackup's, same ownership)
        mkdir -p /var/log/vmrestore
        chown root:backup /var/log/vmrestore
        chmod 750 /var/log/vmrestore

        # Create run directory for lock files
        mkdir -p /run/vmbackup
        chown root:backup /run/vmbackup
        chmod 750 /run/vmbackup

        # AppArmor: reload libvirt VM profiles if AppArmor is active
        if command -v aa-status &>/dev/null && aa-status --enabled 2>/dev/null; then
            reload_count=0
            for profile in /etc/apparmor.d/libvirt/libvirt-*; do
                [[ "$profile" == *.files ]] && continue
                [[ "$(basename "$profile")" == "TEMPLATE.qemu" ]] && continue
                if apparmor_parser -r "$profile" 2>/dev/null; then
                    reload_count=$((reload_count + 1))
                fi
            done
            if [[ $reload_count -gt 0 ]]; then
                echo "AppArmor: Reloaded $reload_count libvirt VM profiles (virtnbdbackup socket access)"
            fi
        fi

        # Reload systemd to pick up new/updated unit files
        systemctl daemon-reload 2>/dev/null || true

        # Enable the timer (but don't start it — let the admin decide when)
        # On first install, the timer won't be running yet.
        # On upgrade, if it was already running, systemd preserves that state.
        if ! systemctl is-enabled vmbackup.timer &>/dev/null; then
            systemctl enable vmbackup.timer 2>/dev/null || true
        fi

        # ---------------------------------------------------------------
        # Post-upgrade advisory: surface .dpkg-dist files awaiting merge
        # and any custom config instances not managed by dpkg. Runs only
        # on upgrade ($2 is the previously-installed version).
        # ---------------------------------------------------------------
        if [[ -n "${2:-}" ]]; then
            # Collect any .dpkg-dist files (default/ is the only conffile,
            # but be future-proof and scan the whole tree).
            mapfile -t _dpkg_dist < <(find /opt/vmbackup/config -name '*.dpkg-dist' 2>/dev/null)
            if (( ${#_dpkg_dist[@]} > 0 )); then
                echo ""
                echo "  NOTICE: This upgrade introduced new config defaults."
                echo "  The package shipped a new vmbackup.conf but kept your"
                echo "  customised file intact. To pick up the new variables,"
                echo "  review and merge:"
                for _f in "${_dpkg_dist[@]}"; do
                    echo "    diff -u ${_f%.dpkg-dist} $_f"
                done
                echo "  Until merged, the running config will use built-in fallbacks"
                echo "  (behaviour is byte-for-byte identical to the previous version)."
                echo "  See /opt/vmbackup/config/template/vmbackup.conf for the full set."
            fi

            # List custom instances (anything under config/ that is not
            # default or template). These are NOT managed by dpkg.
            mapfile -t _custom_instances < <(
                find /opt/vmbackup/config -mindepth 1 -maxdepth 1 -type d \
                    ! -name default ! -name template -printf '%f\n' 2>/dev/null
            )
            if (( ${#_custom_instances[@]} > 0 )); then
                echo ""
                echo "  NOTICE: Custom config instances detected:"
                for _inst in "${_custom_instances[@]}"; do
                    echo "    /opt/vmbackup/config/$_inst/"
                done
                echo "  These are NOT managed by dpkg. New variables introduced"
                echo "  in this release will not be added automatically. To enable"
                echo "  per-instance tuning of the new options, review:"
                echo "    /opt/vmbackup/config/template/vmbackup.conf"
                echo "  and copy any new sections (e.g. # DISK SPACE THRESHOLDS)"
                echo "  into each custom instance config that needs them."
                echo "  Built-in fallbacks apply for any variables not present."
            fi

            # ---------------------------------------------------------------
            # 0.5.5: scan for removed configuration variables.
            # Variables deleted in this release: OFFLINE_CHANGE_DETECTION_THRESHOLD,
            # EMAIL_INCLUDE_REPLICATION, EMAIL_INCLUDE_DISK_SPACE.
            # Stale entries in operator config files are inert (no longer read)
            # but cosmetically misleading. Surface them for cleanup.
            # ---------------------------------------------------------------
            _removed_vars="OFFLINE_CHANGE_DETECTION_THRESHOLD|EMAIL_INCLUDE_REPLICATION|EMAIL_INCLUDE_DISK_SPACE"
            mapfile -t _files_with_removed < <(
                grep -rlE "^[[:space:]]*(${_removed_vars})=" \
                    /opt/vmbackup/config 2>/dev/null \
                    | grep -v '/template/' || true
            )
            if (( ${#_files_with_removed[@]} > 0 )); then
                echo ""
                echo "  NOTICE: This release removed three configuration variables. The"
                echo "  running code no longer reads them; existing entries in your"
                echo "  config files are inert and safe to delete:"
                echo ""
                echo "    - OFFLINE_CHANGE_DETECTION_THRESHOLD  (was never read; replaced"
                echo "                                            by strict mtime comparison)"
                echo "    - EMAIL_INCLUDE_REPLICATION           (replication is always reported"
                echo "                                            when present)"
                echo "    - EMAIL_INCLUDE_DISK_SPACE            (gated a section that was never"
                echo "                                            built; future replacement"
                echo "                                            tracked as ENH-16)"
                echo ""
                echo "  The following files still contain one or more of these settings:"
                for _f in "${_files_with_removed[@]}"; do
                    echo "    $_f"
                done
                echo ""
                echo "  To clean them up automatically, run:"
                echo "    sudo vmbackup --config-prune-removed --dry-run    # preview"
                echo "    sudo vmbackup --config-prune-removed              # apply"
            fi
        fi

        # DUP-10: reap stale chain-manifest.json files left over from
        # pre-decommission backups. Best-effort, never blocks the upgrade.
        # No-op on fresh installs (BACKUP_PATH has no pre-DUP-10 artefacts).
        if [ -x /opt/vmbackup/vmbackup.sh ]; then
            /opt/vmbackup/vmbackup.sh --cleanup-stale-manifests >/dev/null 2>&1 || true
        fi

        echo ""
        echo "=== vmbackup $(grep '^[[:space:]]*readonly[[:space:]]\+VMBACKUP_VERSION=' /opt/vmbackup/lib/version.sh | head -1 | sed 's/.*"\(.*\)"/\1/') installed ==="
        echo ""
        echo "  Install path:  /opt/vmbackup/"
        echo "  Command:       vmbackup --version"
        echo "  Timer:         systemctl start vmbackup.timer   (daily at 1:00 AM)"
        echo "  Manual run:    sudo vmbackup --run"
        echo "  Logs:          journalctl -u vmbackup.service"
        echo ""
        echo "  Config:        /opt/vmbackup/config/default/    (protected on upgrade)"
        echo "  Templates:     /opt/vmbackup/config/template/"
        echo ""
        echo "  Security:      Files owned root:backup (750/640)"
        echo "  Browse backups: sudo usermod -aG backup <username>"
        echo "  virsh access:   sudo usermod -aG libvirt <username>"
        echo ""
        echo "  To create a new config instance:"
        echo "    cp -r /opt/vmbackup/config/template /opt/vmbackup/config/prod"
        echo "    systemctl edit vmbackup.service  # set --run --config-instance prod"
        echo ""
        ;;
esac

exit 0
