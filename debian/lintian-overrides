# vmbackup is installed under /opt/ by design — it's a standalone
# self-contained application that ships its own libs, modules, configs and
# transports as siblings, not as separate FHS components. Per FHS section 3.13,
# /opt is reserved for "add-on application software packages" which is exactly
# the install model used here. Restructuring under /usr/share + /etc + /var/lib
# would scatter ~80 files across the tree and break the single-tree security
# model (root:backup ownership inherited via SGID).
vmbackup: dir-or-file-in-opt

# Conffiles live next to the application under /opt/vmbackup/config/ for the
# same reason — the config directory is part of the self-contained install tree
# and is referenced by the script via $INSTALL_DIR. Splitting configs into /etc
# would require either symlinks or hardcoded /etc paths, both worse than the
# current layout. Debian policy 11.7.2 permits conffiles outside /etc when
# justified by the package layout.
vmbackup: non-etc-file-marked-as-conffile

# Security model: every executable, library and config is mode 0640/0750 owned
# root:backup. World-readable would leak SharePoint OAuth tokens (in
# cloud_transports/) and the backup catalog metadata (in config/). The deb
# package and postinst enforce this layout — it is intentional, documented in
# README.md "Security" section, and not a Lintian-detectable mistake.
vmbackup: non-standard-file-perm
vmbackup: non-standard-executable-perm
vmbackup: executable-is-not-world-readable

# Libraries under lib/ and modules under modules/ are sourced (not exec'd) by
# vmbackup.sh and vmrestore.sh, so they're mode 0640 not 0750 — Lintian's
# heuristic flags them as scripts because they begin with shell syntax, but
# they intentionally do not have the executable bit set.
vmbackup: script-not-executable [opt/vmbackup/lib/*]
vmbackup: script-not-executable [opt/vmbackup/modules/*]
vmbackup: script-not-executable [opt/vmbackup/config/*]

# postinst/postrm call systemctl directly (enable/start vmbackup.timer,
# disable/stop on removal). Debian policy permits this for native packages
# that ship their own systemd units. deb-systemd-helper would be preferred for
# distros that ship it, but this package targets a wider Debian/Ubuntu range
# where direct systemctl calls remain idiomatic and safe.
vmbackup: maintainer-script-calls-systemctl

# postinst does `chown -R root:backup /opt/vmbackup` to enforce the security
# model uniformly across the install tree on every install/upgrade. This is
# the documented hardening step — recursive chown is intentional and bounded
# to the application's own /opt subtree.
vmbackup: recursive-privilege-change
